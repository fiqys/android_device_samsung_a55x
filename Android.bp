soong_namespace {
    imports: ["vendor/samsung/a55x"],
}

cc_library_headers {
    name: "audio_proxy_headers",
    export_include_dirs: ["include"],
}

genrule {
    name: "placeholders",
    out: [
        "AIE.bin",
        "calliope_sram.bin",
        "mfc_fw.bin",
        "os.checked.bin",
        "pablo_icpufw.bin",
        "vts.bin",
        "mx140.bin",
        "slsi_reg_database.bin",
    ],
    cmd: "touch $(out)",
}

prebuilt_firmware {
    name: "AIE.bin_placeholder",
    src: ":placeholders{AIE.bin}",
    filename: "AIE.bin",
    vendor: true,
}

prebuilt_firmware {
    name: "calliope_sram.bin_placeholder",
    src: ":placeholders{calliope_sram.bin}",
    filename: "calliope_sram.bin",
    vendor: true,
}

prebuilt_firmware {
    name: "mfc_fw.bin_placeholder",
    src: ":placeholders{mfc_fw.bin}",
    filename: "mfc_fw.bin",
    vendor: true,
}

prebuilt_firmware {
    name: "pablo_icpufw.bin_placeholder",
    src: ":placeholders{pablo_icpufw.bin}",
    filename: "pablo_icpufw.bin",
    vendor: true,
}

prebuilt_firmware {
    name: "os.checked.bin_placeholder",
    src: ":placeholders{os.checked.bin}",
    filename: "os.checked.bin",
    vendor: true,
}

prebuilt_firmware {
    name: "vts.bin_placeholder",
    src: ":placeholders{vts.bin}",
    filename: "vts.bin",
    vendor: true,
}

prebuilt_firmware {
    name: "mx140.bin_placeholder",
    src: ":placeholders{mx140.bin}",
    filename: "mx140.bin",
    relative_install_path: "wifi",
    vendor: true,
}

prebuilt_firmware {
    name: "slsi_reg_database.bin_placeholder",
    src: ":placeholders{slsi_reg_database.bin}",
    filename: "slsi_reg_database.bin",
    relative_install_path: "wifi",
    vendor: true,
}
